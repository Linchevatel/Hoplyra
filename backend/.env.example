# Bind address (0.0.0.0 — доступ с других машин; 127.0.0.1 — только локально)
HOPLYRA_HOST=0.0.0.0
HOPLYRA_PORT=8787

# Initial panel login (stored in SQLite on first start; change in Settings after login)
HOPLYRA_ADMIN_USER=admin
HOPLYRA_ADMIN_PASSWORD=admin

# Signs browser session cookies (auto-generated by scripts/bootstrap-env.sh on make install)
HOPLYRA_SESSION_SECRET=

# Encrypts SSH passwords in SQLite (auto-generated on make install)
HOPLYRA_SECRET_KEY=

# Optional data directory (default: backend/data)
# HOPLYRA_DATA=/var/lib/hoplyra

# SSL / HTTPS Configuration (native Uvicorn TLS)
# HOPLYRA_SSL_CERTFILE=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# HOPLYRA_SSL_KEYFILE=/etc/letsencrypt/live/yourdomain.com/privkey.pem
# HOPLYRA_SSL_KEY_PASSWORD=
# HOPLYRA_HTTPS_ONLY=1

